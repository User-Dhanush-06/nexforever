# NexForever Full-Stack Environment Configuration Template
# Copy to root `.env` (never commit `.env` to version control).

# MySQL Database Connection
DB_URL=jdbc:mysql://localhost:3306/nexforever_db
DB_USERNAME=nexforever_app
DB_PASSWORD=replace_with_your_local_password

# Admin Bootstrap (creates initial admin only if admins table is empty)
ADMIN_EMAIL=admin@nexforever.studio
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_FULL_NAME=NexForever Studio Admin

# Security & Media Storage
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_IP_HASH_SALT=replace_with_random_salt_for_enquiry_ip_hashing
APP_MEDIA_UPLOAD_DIR=./backend/uploads
